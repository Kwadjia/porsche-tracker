# Copy to .env and fill in. Never commit real secrets.

# Postgres. Local dev via docker, or a Neon connection string in prod.
DATABASE_URL=postgresql+psycopg://porsche:porsche@localhost:5432/porsche

# eBay Browse API — https://developer.ebay.com (free). Create a Production app,
# use its Client ID / Client Secret (client-credentials grant, no user login).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_MOTORS

# Google Programmable Search (dealer discovery; 100 free queries/day) — optional
GOOGLE_PSE_KEY=
GOOGLE_PSE_CX=

HOME_ZIP=10001
